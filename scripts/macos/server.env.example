# Copy to ~/.config/software-factory/server.env and chmod 600.
# No spaces around '='; zsh source will load this file.
export FACTORY_REPO_PATH="$HOME/projects/your-react-project"
export FACTORY_DATA_DIR="$HOME/.local/share/software-factory"
export FACTORY_API_TOKEN="REPLACE_WITH_OPENSSL_RAND_HEX_32"
export FACTORY_BIND="127.0.0.1:8787"
# Optional: absolute Herdr binary path when launchd can't resolve it.
export HERDR_BIN="$HOME/.local/bin/herdr"
